# Cloudflare Worker local runtime
# Wrangler reads this file for npm run dev:worker and npm run dev:full.

# Used by worker/db/client.ts to connect the API to Neon Postgres.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Used by worker/lib/auth.ts to verify Neon Auth bearer JWTs.
NEON_AUTH_URL="https://ep-xxxx.neonauth....../neondb/auth"

# Attachment uploads use the ATTACHMENTS_BUCKET R2 binding in wrangler.toml.
# Do not add R2 API keys here for normal Worker runtime access.
