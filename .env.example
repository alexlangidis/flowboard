# Browser / Vite
# Used by src/lib/api-client.ts to call the Cloudflare Worker API.
VITE_API_URL=http://localhost:8787

# Public Neon Auth endpoint used by src/lib/auth-client.ts for login, signup,
# session lookup, and password reset screens.
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth....../neondb/auth

# Database CLI / migrations
# Used by drizzle.config.ts when running npm run db:generate or npm run db:migrate.
DATABASE_URL=

# Optional fallback for drizzle.config.ts if DATABASE_URL is not set.
NEON_DATABASE_URL=

# Attachment upload storage is not enabled yet.
# Add R2 deploy/admin credentials later only if attachment upload setup needs them.
